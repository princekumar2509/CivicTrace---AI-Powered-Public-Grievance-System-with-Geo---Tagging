
@page
@model PublicGrievanceSystem.Areas.Identity.Pages.Account.ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div style="font-size: 48px;">🔐</div>

                        <h2 class="fw-bold mt-2">Reset Password</h2>

                        <p class="text-muted">
                            Choose a new password for your CivicTrace account.
                        </p>
                    </div>

                    @if (Model.InvalidLink)
                    {
                        <div class="alert alert-danger" role="alert">
                            This password-reset link is invalid or incomplete.
                            Please request a new reset link.
                        </div>

                        <a asp-page="/Account/ForgotPassword"
                           asp-route-loginType="@Model.LoginType"
                           class="btn btn-outline-primary btn-lg w-100">
                            Request a New Reset Link
                        </a>
                    }
                    else
                    {
                        <form method="post">
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="Code" />
                            <input type="hidden" asp-for="LoginType" />

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"
                                 role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Input.Password"
                                       class="form-label fw-semibold">
                                    New Password
                                </label>

                                <input asp-for="Input.Password"
                                       class="form-control form-control-lg"
                                       autocomplete="new-password"
                                       placeholder="Enter a new password" />

                                <span asp-validation-for="Input.Password"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Input.ConfirmPassword"
                                       class="form-label fw-semibold">
                                    Confirm New Password
                                </label>

                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control form-control-lg"
                                       autocomplete="new-password"
                                       placeholder="Re-enter your new password" />

                                <span asp-validation-for="Input.ConfirmPassword"
                                      class="text-danger"></span>
                            </div>

                            <button type="submit"
                                    class="btn btn-outline-primary btn-lg w-100">
                                Reset Password
                            </button>
                        </form>
                    }

                    <div class="text-center mt-4">
                        <a asp-page="/Account/LoginChoice"
                           class="text-decoration-none">
                            ← Back to Login Options
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
