
@page
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5 text-center">

                    <div style="font-size: 56px;">📩</div>

                    <h2 class="fw-bold mt-3">Check Your Email</h2>

                    <p class="text-muted mt-3">
                        If an eligible CivicTrace account matches the
                        email address you entered, a password-reset link
                        will be sent to that address.
                    </p>

                    <p class="text-muted">
                        Please check your inbox and spam folder.
                        The link will let you choose a new password.
                    </p>

                    <a asp-page="/Account/LoginChoice"
                    class="btn btn-outline-primary btn-lg w-100 mt-3">
                        Back to Login Options
                    </a>

                    <a asp-page="/Index"
                    asp-area=""
                    class="btn btn-link mt-2 text-decoration-none">
                        Return to Home
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>
