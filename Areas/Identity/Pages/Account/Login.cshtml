
@page
@model PublicGrievanceSystem.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="container py-5 civictrace-login-page">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 civictrace-login-card">
                <div class="card-body p-4 p-md-5">
                    @if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

                    <div class="text-center mb-4">
                        <div class="civictrace-login-icon">
    @(Model.LoginType == "Admin" ? "🏛️" : "👤")
</div>

                        <h2 class="fw-bold mt-2">@Model.PageTitle</h2>

                        <p class="text-muted">
                            Sign in to your CivicTrace account
                        </p>
                    </div>

                    <form method="post">
                        <input type="hidden"
                            asp-for="LoginType" />

                        <input type="hidden"
                            asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly"
                            class="text-danger mb-3"
                            role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email"
                                class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Input.Email"
                                class="form-control form-control-lg"
                                autocomplete="username"
                                placeholder="Enter your email address" />

                            <span asp-validation-for="Input.Email"
                                class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password"
                                class="form-label fw-semibold">
                                Password
                            </label>

                            <input asp-for="Input.Password"
                                class="form-control form-control-lg"
                                autocomplete="current-password"
                                placeholder="Enter your password" />

                            <span asp-validation-for="Input.Password"
                                class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Input.RememberMe"
                                class="form-check-input" />

                            <label asp-for="Input.RememberMe"
                                class="form-check-label">
                            </label>
                        </div>

                        <button type="submit"
        class="btn btn-lg w-100 civictrace-login-submit">
    Login as @Model.LoginType
</button>
                    </form>

<div class="text-center my-3">
    <span class="text-muted">— or continue with —</span>
</div>

<form asp-area="Identity"
    asp-page="/Account/ExternalLogin"
    asp-route-returnUrl="@Model.ReturnUrl"
    asp-route-loginType="@Model.LoginType"
    method="post">

    <button type="submit"
            name="provider"
            value="Google"
            class="btn btn-lg w-100 d-flex align-items-center justify-content-center gap-2 civictrace-google-button">

        <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
    alt=""
    aria-hidden="true"
    style="width: 24px;
            height: 24px;
            margin-right: 12px;
            flex-shrink: 0;" />

        Continue with Google
    </button>
</form>

<div class="text-center mt-3">
    <a asp-page="/Account/ForgotPassword"
    asp-route-loginType="@Model.LoginType"
    asp-route-returnUrl="@Model.ReturnUrl"
    class="text-decoration-none">
        Forgot Password?
    </a>
</div>


                    <div class="text-center mt-4">
                        <a asp-page="/Account/LoginChoice"
                        class="text-decoration-none">
                            ← Back to login options
                        </a>
                    </div>

                    <div class="text-center mt-3">
                        <span class="text-muted">
                            Don't have an account?
                        </span>

                        <a asp-page="/Account/Register"
                           class="text-decoration-none fw-semibold">
                            Register
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
