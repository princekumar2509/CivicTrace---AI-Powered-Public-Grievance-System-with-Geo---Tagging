
@page
@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5 text-center">

                    <div style="font-size: 56px;">✅</div>

                    <h2 class="fw-bold mt-3">
                        Password Reset Successful
                    </h2>

                    <p class="text-muted mt-3">
                        Your CivicTrace password has been changed
                        successfully. You can now sign in using
                        your new password.
                    </p>

                    <a asp-page="/Account/LoginChoice"
                    class="btn btn-outline-primary btn-lg w-100 mt-3">
                        Go to Login Options
                    </a>

                    <a asp-area=""
                    asp-controller="Home"
                    asp-action="Index"
                    class="btn btn-link mt-2 text-decoration-none">
                        Return to Home
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>
