
@page
@model PublicGrievanceSystem.Areas.Identity.Pages.Account.VerifyEmailOtpModel

@{
    ViewData["Title"] = "Verify Email";
}

<style>
    .civictrace-otp-page {
        max-width: 620px;
        margin: 0 auto;
        padding-top: 45px;
        padding-bottom: 55px;
    }

    .civictrace-otp-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #dce7f5;
        border-radius: 20px;
        box-shadow: 0 14px 38px rgba(20, 45, 78, 0.10);
    }

    .civictrace-otp-header {
        padding: 28px 24px;
        text-align: center;
        color: #ffffff;
        background: linear-gradient(120deg, #142d4e, #245ca8);
    }

    .civictrace-otp-icon {
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.3);
        font-size: 38px;
    }

    .civictrace-otp-header h1 {
        margin-bottom: 8px;
        font-size: 1.8rem;
        font-weight: 800;
    }

    .civictrace-otp-header p {
        margin: 0;
        color: #e5efff;
        line-height: 1.6;
    }

    .civictrace-otp-body {
        padding: 30px;
    }

    .civictrace-otp-body .form-label {
        color: #243b58;
        font-weight: 650;
    }

    .civictrace-otp-body .form-control {
        min-height: 48px;
        border: 1px solid #d2deec;
        border-radius: 9px;
    }

    .civictrace-otp-body .form-control:focus {
        border-color: #4381c9;
        box-shadow: 0 0 0 4px rgba(36, 92, 168, 0.12);
    }

    .civictrace-otp-input {
        text-align: center;
        font-size: 1.8rem !important;
        font-weight: 750;
        letter-spacing: 10px;
    }

    .civictrace-otp-primary {
        min-height: 49px;
        border: 1px solid #245ca8;
        border-radius: 9px;
        background: linear-gradient(120deg, #142d4e, #245ca8);
        color: #ffffff;
        font-weight: 700;
        transition: all 0.2s ease;
    }

    .civictrace-otp-primary:hover {
        background: linear-gradient(120deg, #0e213a, #1b4b8c);
        border-color: #1b4b8c;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(20, 45, 78, 0.18);
    }

    .civictrace-otp-secondary {
        min-height: 45px;
        border: 1px solid #cbd8e8;
        border-radius: 9px;
        background: #ffffff;
        color: #245ca8;
        font-weight: 600;
    }

    .civictrace-otp-secondary:hover {
        background: #eaf2ff;
        color: #153b6d;
        border-color: #245ca8;
    }

    .civictrace-otp-note {
        padding: 13px 15px;
        border: 1px solid #d7e5f8;
        border-radius: 9px;
        background: #f3f7fd;
        color: #52647a;
        font-size: 0.92rem;
        line-height: 1.6;
    }

    .civictrace-otp-back {
        display: inline-block;
        color: #245ca8;
        text-decoration: none;
        font-weight: 600;
    }

    .civictrace-otp-back:hover {
        color: #142d4e;
        text-decoration: underline;
    }

    @@media (max-width: 575.98px) {
        .civictrace-otp-page {
            padding: 25px 14px 35px;
        }

        .civictrace-otp-body {
            padding: 23px 19px;
        }

        .civictrace-otp-header {
            padding: 25px 18px;
        }

        .civictrace-otp-input {
            letter-spacing: 7px;
        }
    }
</style>

<div class="container civictrace-otp-page">
    <div class="civictrace-otp-card">

        <div class="civictrace-otp-header">
            <div class="civictrace-otp-icon">✉️</div>

            <h1>Verify Your Email</h1>

            <p>
                One quick step to secure your CivicTrace account.
            </p>
        </div>

        <div class="civictrace-otp-body">

            @if (TempData["OtpNotice"] is string notice)
            {
                <div class="alert alert-info" role="status">
                    @notice
                </div>
            }

            @if (TempData["OtpError"] is string otpError)
            {
                <div class="alert alert-warning" role="alert">
                    @otpError
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-success" role="status">
                    @Model.StatusMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <p class="text-secondary text-center mb-4">
                Enter the six-digit verification code sent to your email address.
            </p>

            <form method="post" asp-page-handler="Verify">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        Registered Email Address
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           readonly />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Otp" class="form-label">
                        Six-Digit Verification Code
                    </label>

                    <input asp-for="Otp"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]{6}"
                           maxlength="6"
                           minlength="6"
                           autocomplete="one-time-code"
                           class="form-control civictrace-otp-input"
                           placeholder="000000"
                           aria-describedby="otpHelp"
                           required />

                    <span asp-validation-for="Otp"
                          class="text-danger"></span>

                    <div id="otpHelp" class="form-text">
                        The code expires five minutes after it is sent.
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert"></div>

                <button type="submit"
                        class="btn civictrace-otp-primary w-100">
                    Verify Email
                </button>
            </form>

            <div class="civictrace-otp-note mt-4">
                <strong>Didn't receive the code?</strong>
                Check your spam folder or request another code below.
            </div>

            <form method="post"
                  asp-page-handler="Resend"
                  class="mt-3">

                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="ReturnUrl" />

                <button type="submit"
                        class="btn civictrace-otp-secondary w-100">
                    ↻ Resend Verification Code
                </button>
            </form>

            <div class="text-center mt-4">
                <a asp-page="/Account/Register"
                   class="civictrace-otp-back">
                    ← Back to Registration
                </a>
            </div>

        </div>
    </div>
</div>
