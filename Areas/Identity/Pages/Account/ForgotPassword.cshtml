
@page
@model PublicGrievanceSystem.Areas.Identity.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div style="font-size: 48px;">🔐</div>

                        <h2 class="fw-bold mt-2">Forgot Password?</h2>

                        <p class="text-muted">
                            Enter the email address associated with your
                            CivicTrace account. We'll email you a password-reset link.
                        </p>

                        <span class="badge bg-primary">
                            @Model.LoginType Login
                        </span>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="LoginType" />
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Input.Email"
                                   class="form-label fw-semibold">
                                Registered Email Address
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control form-control-lg"
                                   autocomplete="email"
                                   placeholder="Enter your email address" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-outline-primary btn-lg w-100">
                            Send Reset Link
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-page="/Account/Login"
                           asp-route-loginType="@Model.LoginType"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           class="text-decoration-none">
                            ← Back to Login
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
