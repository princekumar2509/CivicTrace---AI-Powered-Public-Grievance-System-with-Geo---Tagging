@model IEnumerable<PublicGrievanceSystem.Models.Complaint>

@using System.Text.Json

@{
    ViewData["Title"] = "Authority Dashboard";

    var complaints = Model.ToList();
    var mostSupportedComplaints =
    ViewBag.MostSupportedComplaints as
        List<PublicGrievanceSystem.Models.CommunityComplaintViewModel>
    ?? new List<PublicGrievanceSystem.Models.CommunityComplaintViewModel>();
        var pendingResolutionReviews =
    ViewBag.PendingResolutionReviews
    as List<PublicGrievanceSystem.Models.ComplaintResolutionResponse>
    ?? new List<PublicGrievanceSystem.Models.ComplaintResolutionResponse>();
        var overdueComplaints =
    ViewBag.OverdueComplaints
    as List<PublicGrievanceSystem.Models.Complaint>
    ?? new List<PublicGrievanceSystem.Models.Complaint>();

var escalatedComplaints =
    ViewBag.EscalatedComplaints
    as List<PublicGrievanceSystem.Models.Complaint>
    ?? new List<PublicGrievanceSystem.Models.Complaint>();

    var totalComplaints = complaints.Count;

    var submittedCount = complaints.Count(c =>
        c.Status == "Submitted");

    var inProgressCount = complaints.Count(c =>
        c.Status == "In Progress");

    var resolvedCount = complaints.Count(c =>
        c.Status == "Resolved");

    var complaintMapData = complaints.Select(c => new
    {
        id = c.Id,
        title = c.Title,
        category = c.Category,
        status = c.Status,
        priority = c.Priority,
        severity = c.AISeverity,
        department = c.Department ?? "",
        latitude = c.Latitude,
        longitude = c.Longitude,
        address = c.Address ?? "",
        pinCode = c.PinCode ?? ""
    });

var highPriorityComplaints =
    Model.Count(c => c.Priority == "High");

var mediumPriorityComplaints =
    Model.Count(c => c.Priority == "Medium");

var lowPriorityComplaints =
    Model.Count(c => c.Priority == "Low");

    var criticalSeverityComplaints =
    Model.Count(c => c.AISeverity == "Critical");

var highSeverityComplaints =
    Model.Count(c => c.AISeverity == "High");

var mediumSeverityComplaints =
    Model.Count(c => c.AISeverity == "Medium");

var lowSeverityComplaints =
    Model.Count(c => c.AISeverity == "Low");

var assignedComplaints =
    Model.Count(c => !string.IsNullOrEmpty(c.Department));

var unassignedComplaints =
    Model.Count(c => string.IsNullOrEmpty(c.Department));

var departmentCounts = Model
    .Where(c => !string.IsNullOrEmpty(c.Department))
    .GroupBy(c => c.Department)
    .Select(g => new
    {
        Department = g.Key,
        Count = g.Count()
    })
    .OrderByDescending(x => x.Count)
    .ToList();
var categorySeverityCounts = Model
    .GroupBy(c => c.Category)
    .Select(g => new
    {
        Category = g.Key,
        Critical = g.Count(c => c.AISeverity == "Critical"),
        High = g.Count(c => c.AISeverity == "High"),
        Medium = g.Count(c => c.AISeverity == "Medium"),
        Low = g.Count(c => c.AISeverity == "Low")
    })
    .OrderByDescending(x =>
        x.Critical + x.High + x.Medium + x.Low)
    .ToList();
}
