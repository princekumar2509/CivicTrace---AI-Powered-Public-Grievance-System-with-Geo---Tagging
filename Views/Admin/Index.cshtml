<link rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    crossorigin="" />


<!-- ========================================================= -->
<!-- LEAFLET JS -->
<!-- ========================================================= -->

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        crossorigin=""></script>

        <!-- CHART.JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<!-- ========================================================= -->
<!-- OUR JAVASCRIPT -->
<!-- ========================================================= -->

<script>

    // =========================================================
    // COMPLAINT DATA FROM ASP.NET
    // =========================================================

    const complaintData =
        @Html.Raw(JsonSerializer.Serialize(complaintMapData));

        // =========================================================
// AI SEVERITY CHART
// =========================================================

const aiSeverityChartElement =
    document.getElementById("aiSeverityChart");

if (aiSeverityChartElement) {

    new Chart(aiSeverityChartElement, {

        type: "bar",

        data: {
            labels: [
                "Critical",
                "High",
                "Medium",
                "Low"
            ],

            datasets: [{
                label: "Complaints",

                data: [
                    @criticalSeverityComplaints,
                    @highSeverityComplaints,
                    @mediumSeverityComplaints,
                    @lowSeverityComplaints
                ],

                backgroundColor: [
                    "#dc3545",
                    "#fd7e14",
                    "#ffc107",
                    "#198754"
                ],

                borderWidth: 1,

                borderRadius: 8
            }]
        },

        options: {

            indexAxis: "y",

            responsive: true,

            maintainAspectRatio: false,

            plugins: {

                legend: {
                    display: false
                },

                title: {
                    display: true,
                    text: "Complaint Severity Distribution",
                    font: {
                        size: 18,
                        weight: "bold"
                    }
                }
            },

            scales: {

                x: {
                    beginAtZero: true,

                    ticks: {
                        precision: 0,
                        stepSize: 1
                    },

                    title: {
                        display: true,
                        text: "Number of Complaints"
                    }
                },

                y: {
                    title: {
                        display: true,
                        text: "AI Severity"
                    }
                }
            }
        }
    });
}


    // =========================================================
    // CREATE LEAFLET MAP
    // =========================================================

    const hotspotMap =
        L.map("hotspotMap").setView(
            [23.3441, 85.3096],
            7
        );


    // =========================================================
    // OPENSTREETMAP TILE LAYER
    // =========================================================

    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution:
                "&copy; OpenStreetMap contributors"
        }
    ).addTo(hotspotMap);


    // =========================================================
    // STORE MARKERS
    // =========================================================

    const complaintMarkers = [];


    // =========================================================
    // ADD COMPLAINT MARKERS
    // =========================================================

    complaintData.forEach(function (complaint) {

        const latitude =
            Number(complaint.latitude);

        const longitude =
            Number(complaint.longitude);


        // Ignore invalid coordinates

        if (
            !Number.isFinite(latitude) ||
            !Number.isFinite(longitude) ||
            (latitude === 0 && longitude === 0)
        ) {

            return;

        }


        // Create marker

        const marker =
            L.marker([
                latitude,
                longitude
            ]);


        // Popup content

        const popupContent =

            "<div style='min-width:220px;'>" +

                "<h5 style='margin-bottom:8px;'>" +

                    "Complaint #" +
                    complaint.id +

                "</h5>" +

                "<strong>" +
                    escapeHtml(complaint.title) +
                "</strong>" +

                "<br>" +

                "<b>Category:</b> " +
                escapeHtml(complaint.category) +

                "<br>" +

                "<b>Status:</b> " +
                escapeHtml(complaint.status) +

                "<br>" +

                "<b>Priority:</b> " +
escapeHtml(complaint.priority) +
"<br>" +

"<b>AI Severity:</b> " +
escapeHtml(complaint.severity || "Not Available") +
"<br>" +

"<b>Department:</b> " +
                (
                    complaint.department
                    ? escapeHtml(complaint.department)
                    : "Not Assigned"
                ) +

                "<br><br>" +

                "<a href='/Admin/Details/" +
                    complaint.id +
                    "' class='btn btn-sm btn-primary'>" +

                    "View Complaint" +

                "</a>" +

            "</div>";


        marker.bindPopup(
            popupContent
        );


        // Add marker to map

        marker.addTo(
            hotspotMap
        );


        // Save marker information

        complaintMarkers.push({

            id: complaint.id,

            marker: marker,

            title:
                (complaint.title || "")
                    .toLowerCase(),

            location:
                (complaint.address || "")
                    .toLowerCase(),

            category:
                (complaint.category || "")
                    .toLowerCase(),

            status:
                (complaint.status || "")
                    .toLowerCase(),

            priority:
                (complaint.priority || "")
                    .toLowerCase(),
                    severity:
        (complaint.severity || "")
            .toLowerCase(),

            department:
                (complaint.department || "")
                    .toLowerCase()

        });

    });


    // =========================================================
    // FIT MAP TO COMPLAINT LOCATIONS
    // =========================================================

    if (complaintMarkers.length > 0) {

        const bounds =
            L.latLngBounds(
                complaintMarkers.map(function (item) {

                    return item.marker.getLatLng();

                })
            );

        hotspotMap.fitBounds(
            bounds,
            {
                padding: [30, 30]
            }
        );

    }


    // =========================================================
    // ESCAPE HTML
    // =========================================================

    function escapeHtml(value) {

        if (!value) {
            return "";
        }

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    // =========================================================
    // FILTER ELEMENTS
    // =========================================================

    const searchInput =
        document.getElementById(
            "searchInput"
        );

    const statusFilter =
        document.getElementById(
            "statusFilter"
        );

    const categoryFilter =
        document.getElementById(
            "categoryFilter"
        );

    const priorityFilter =
        document.getElementById(
            "priorityFilter"
        );

const severityFilter =
    document.getElementById(
        "severityFilter"
    );

    const departmentFilter =
        document.getElementById(
            "departmentFilter"
        );

    const resetFilters =
        document.getElementById(
            "resetFilters"
        );

    const filterResult =
        document.getElementById(
            "filterResult"
        );

    const complaintRows =
        document.querySelectorAll(
            ".complaint-row"
        );
        


    // =========================================================
    // FILTER FUNCTION
    // =========================================================

    function filterComplaints() {

        const searchValue =
            searchInput.value
                .toLowerCase()
                .trim();

        const statusValue =
            statusFilter.value
                .toLowerCase();

        const categoryValue =
            categoryFilter.value
                .toLowerCase();

        const priorityValue =
            priorityFilter.value
                .toLowerCase();

                const severityValue =
    severityFilter.value
        .toLowerCase();

        const departmentValue =
            departmentFilter.value
                .toLowerCase();


        let visibleCount = 0;


        // -----------------------------------------------------
        // FILTER TABLE ROWS
        // -----------------------------------------------------

        complaintRows.forEach(function (row) {

            const title =
                (row.dataset.title || "")
                    .toLowerCase();

            const location =
                (row.dataset.location || "")
                    .toLowerCase();

            const category =
                (row.dataset.category || "")
                    .toLowerCase();

            const status =
                (row.dataset.status || "")
                    .toLowerCase();

            const priority =
                (row.dataset.priority || "")
                    .toLowerCase();

                    const severity =
    (row.dataset.severity || "")
        .toLowerCase();

            const department =
                (row.dataset.department || "")
                    .toLowerCase();


            const matchesSearch =
                searchValue === "" ||
                title.includes(searchValue) ||
                location.includes(searchValue);


            const matchesStatus =
                statusValue === "" ||
                status === statusValue;


            const matchesCategory =
                categoryValue === "" ||
                category === categoryValue;


            const matchesPriority =
                priorityValue === "" ||
                priority === priorityValue;

                const matchesSeverity =
    severityValue === "" ||
    severity === severityValue;


            const matchesDepartment =
                departmentValue === "" ||
                department === departmentValue;


            const shouldShow =

                matchesSearch &&
                matchesStatus &&
                matchesCategory &&
                matchesPriority &&
                matchesSeverity &&
                matchesDepartment;


            if (shouldShow) {

                row.style.display = "";

                visibleCount++;

            }
            else {

                row.style.display = "none";

            }

        });


        // -----------------------------------------------------
        // FILTER MAP MARKERS
        // -----------------------------------------------------

        complaintMarkers.forEach(function (item) {

            const matchesSearch =
                searchValue === "" ||
                item.title.includes(searchValue) ||
                item.location.includes(searchValue);


            const matchesStatus =
                statusValue === "" ||
                item.status === statusValue;


            const matchesCategory =
                categoryValue === "" ||
                item.category === categoryValue;


            const matchesPriority =
                priorityValue === "" ||
                item.priority === priorityValue;


            const matchesDepartment =
                departmentValue === "" ||
                item.department === departmentValue;


            const shouldShow =

                matchesSearch &&
                matchesStatus &&
                matchesCategory &&
                matchesPriority &&
                matchesDepartment;


            if (shouldShow) {

                if (!hotspotMap.hasLayer(
                    item.marker
                )) {

                    item.marker.addTo(
                        hotspotMap
                    );

                }

            }
            else {

                if (hotspotMap.hasLayer(
                    item.marker
                )) {

                    hotspotMap.removeLayer(
                        item.marker
                    );

                }

            }

        });


        // -----------------------------------------------------
        // RESULT MESSAGE
        // -----------------------------------------------------

        filterResult.textContent =

            "Showing " +
            visibleCount +
            " of " +
            complaintRows.length +
            " complaints";

    }


    // =========================================================
    // FILTER EVENTS
    // =========================================================

    searchInput.addEventListener(
        "input",
        filterComplaints
    );


    statusFilter.addEventListener(
        "change",
        filterComplaints
    );


    categoryFilter.addEventListener(
        "change",
        filterComplaints
    );


    priorityFilter.addEventListener(
        "change",
        filterComplaints
    );

    severityFilter.addEventListener(
    "change",
    filterComplaints
);


    departmentFilter.addEventListener(
        "change",
        filterComplaints
    );


    // =========================================================
    // RESET FILTERS
    // =========================================================

    resetFilters.addEventListener(
        "click",
        function () {

            searchInput.value = "";

            statusFilter.value = "";

            categoryFilter.value = "";

            priorityFilter.value = "";

            severityFilter.value = "";

            departmentFilter.value = "";

            filterComplaints();

        }
    );


    // =========================================================
    // INITIAL FILTER STATE
    // =========================================================

    filterComplaints();

</script>