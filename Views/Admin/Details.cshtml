@model PublicGrievanceSystem.Models.Complaint
@{
    string suggestedDepartment = Model.Category?.ToLower() switch
    {
        "road" => "Road & Transport",
        "pothole" => "Road & Transport",
        "garbage" => "Sanitation",
        "waste" => "Sanitation",
        "streetlight" => "Electrical",
        "electricity" => "Electricity Department",
        "water" => "Water Supply",
        "water leakage" => "Water Supply",
        "drainage" => "Public Works",
        "sewage" => "Public Works",
        _ => ""
    };

    string selectedDepartment =
        !string.IsNullOrEmpty(Model.Department)
            ? Model.Department
            : suggestedDepartment;
}
@{
    ViewData["Title"] = "Complaint Details";
}

<link rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    crossorigin="" />

<div class="container mt-4 mb-5 admin-complaint-details">

