<!-- RESOLUTION PROOF -->

<div class="card shadow mb-4">

    <div class="card-header bg-success text-white">
        <h5 class="mb-0">
            ✅ Resolution Proof (After)
        </h5>
    </div>

    <div class="card-body">

        @if (TempData["ResolutionProofSuccess"] != null)
        {
            <div class="alert alert-success">
                ✅ @TempData["ResolutionProofSuccess"]
            </div>
        }

        @if (TempData["ResolutionProofError"] != null)
        {
            <div class="alert alert-danger">
                ⚠️ @TempData["ResolutionProofError"]
            </div>
        }

        @{
            var resolutionEvidence =
                ViewBag.ResolutionEvidence
                as List<PublicGrievanceSystem.Models.ComplaintResolutionEvidence>
                ?? new List<PublicGrievanceSystem.Models.ComplaintResolutionEvidence>();
        }

        @if (resolutionEvidence.Any())
        {
            <h6 class="fw-bold mb-3">
                Uploaded Resolution Photographs
            </h6>

            <div class="row g-3">

                @foreach (var evidence in resolutionEvidence)
                {
                    <div class="col-12">

                        <img src="@evidence.ImagePath"
                             alt="Resolution Proof"
                             class="img-fluid rounded border"
                             style="width:100%; max-height:300px; object-fit:contain;" />

                        <small class="text-muted d-block mt-2">
                            Uploaded on:
                            @evidence.UploadedAt.ToString("dd-MM-yyyy hh:mm tt")
                        </small>

                    </div>
                }

            </div>

            <hr />
        }
        else
        {
            <div class="text-center py-3 text-muted">
                <div class="display-5">📷</div>
                <p class="mt-2 mb-0">
                    No resolution photograph uploaded yet.
                </p>
            </div>
        }

        @if (Model.Status == "Resolved")
        {
            <form asp-controller="Admin"
                  asp-action="UploadResolutionProof"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Upload After-Resolution Photograph
                    </label>

<!-- GALLERY AND CAMERA OPTIONS -->

<div class="d-flex flex-wrap align-items-center gap-2 mb-2">

    <!-- GALLERY OPTION -->
    <input type="file"
           id="resolutionGalleryFile"
           name="file"
           class="form-control"
           accept="image/jpeg,image/png,image/webp"
           style="width: 380px; max-width: 100%;" />

    <!-- HIDDEN CAMERA INPUT -->
    <input type="file"
           id="resolutionCameraFile"
           name="cameraFile"
           accept="image/*"
           capture="environment"
           class="d-none" />

    <!-- CAMERA BUTTON -->
    <button type="button"
            class="btn btn-outline-primary"
            onclick="document.getElementById('resolutionCameraFile').click()">

        📷 Take Photo

    </button>

</div>

                    <small class="text-muted">
                        Upload a photograph showing the completed repair.
                    </small>

                </div>

                <button type="submit"
                        class="btn btn-success">
                    📤 Upload Resolution Proof
                </button>

            </form>
        }
        else
        {
            <div class="alert alert-info mb-0">
                ℹ️ Mark this complaint as Resolved before uploading
                its resolution photograph.
            </div>
        }

    </div>

</div>

<!-- CITIZEN RESOLUTION OBJECTION REVIEW -->

@if (TempData["ReviewMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show mb-4">
        @TempData["ReviewMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

@if (ViewBag.PendingResolutionResponses is
    List<PublicGrievanceSystem.Models.ComplaintResolutionResponse> pendingResponses
    && pendingResponses.Any())
{
    <div class="card shadow mb-4">

        <div class="card-header text-white"
             style="background:linear-gradient(120deg,#9b3d32,#d45b45);">

            <h5 class="mb-0">
                ⚠️ Citizen Resolution Objection
            </h5>

        </div>

        <div class="card-body">

            @foreach (var response in pendingResponses)
            {
                <div class="border rounded p-3 mb-3">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <strong>
                            Complaint #@response.ComplaintId
                        </strong>

                        <span class="badge bg-warning text-dark">
                            Pending Review
                        </span>

                    </div>

                    <div class="mb-3">

                        <strong>Citizen's Remarks:</strong>

                        <div class="bg-light border rounded p-3 mt-2">
                            @(string.IsNullOrWhiteSpace(response.Remarks)
                                ? "No remarks provided."
                                : response.Remarks)
                        </div>

                    </div>

                    <p class="text-muted small">
                        Reported on:
                        @response.RespondedAt.ToString(
                            "dd MMM yyyy, hh:mm tt")
                    </p>

                    <hr />

                    <form asp-controller="Admin"
                          asp-action="ReviewResolutionResponse"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="responseId"
                               value="@response.Id" />

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Administrator Remarks
                            </label>

                            <textarea name="adminRemarks"
                                      class="form-control"
                                      rows="3"
                                      maxlength="1000"
                                      placeholder="Enter your review decision or explanation..."></textarea>

                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    name="decision"
                                    value="Reopened"
                                    class="btn btn-success"
                                    onclick="return confirm('Approve this objection and reopen the complaint?');">

                                ✅ Approve Reopening

                            </button>

                            <button type="submit"
                                    name="decision"
                                    value="Rejected"
                                    class="btn btn-outline-danger"
                                    onclick="return confirm('Reject this objection? The complaint will remain resolved.');">

                                ❌ Reject Request

                            </button>

                        </div>

                    </form>

                </div>
            }

        </div>

    </div>
}

            <!-- MAP -->

            <div class="card shadow">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">
                        🗺️ Complaint Location
                    </h5>

                </div>

                <div class="card-body p-0">

                    <div id="complaintMap"
                         style="
                            height:350px;
                            width:100%;
                         ">
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        crossorigin=""></script>


<script>

    // Complaint coordinates from database

    const latitude = @Model.Latitude;
    const longitude = @Model.Longitude;


    // Create map

    const map = L.map("complaintMap").setView(
        [latitude, longitude],
        17
    );


    // OpenStreetMap tiles

    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution:
                "&copy; OpenStreetMap contributors"
        }
    ).addTo(map);


    // Add complaint marker

    const marker = L.marker(
        [latitude, longitude]
    ).addTo(map);


    marker.bindPopup(
        "<b>Complaint #" + @Model.Id + "</b><br>" +
        "Latitude: " + latitude + "<br>" +
        "Longitude: " + longitude
    ).openPopup();

</script>
