                                    <span class="badge bg-warning text-dark">
                                        Medium
                                    </span>
                                }
                            </div>
                            <!-- AI SEVERITY -->
<div class="mt-3">

    <strong>🤖 AI Severity:</strong>

    <div>
        @if (Model.AISeverity == "Critical")
        {
            <span class="badge bg-danger">
                🚨 Critical
            </span>
        }
        else if (Model.AISeverity == "High")
        {
            <span class="badge bg-danger">
                🔴 High
            </span>
        }
        else if (Model.AISeverity == "Medium")
        {
            <span class="badge bg-warning text-dark">
                🟡 Medium
            </span>
        }
        else
        {
            <span class="badge bg-success">
                🟢 Low
            </span>
        }
    </div>

    <small class="text-muted">
        Automatically predicted by AI
    </small>

</div>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>Status:</strong>

                            <div>

                                @if (Model.Status == "Resolved")
                                {
                                    <span class="badge bg-success">
                                        ✅ Resolved
                                    </span>
                                }
                                else if (Model.Status == "In Progress")
                                {
                                    <span class="badge bg-info text-dark">
                                        🔄 In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        📨 Submitted
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                    <hr />

                    <!-- ADDRESS -->

                    <div class="mb-3">

                        <strong>🏠 Complete Address:</strong>

                        <div class="mt-1">
                            @(string.IsNullOrEmpty(Model.Address)
                                ? "Address not available"
                                : Model.Address)
                        </div>

                    </div>


                    <div class="mb-3">

