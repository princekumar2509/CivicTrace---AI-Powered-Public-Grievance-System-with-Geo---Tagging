                    </div>


                    <!-- COORDINATES -->

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <strong>Latitude:</strong>

                            <div>
                                @Model.Latitude
                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <strong>Longitude:</strong>

                            <div>
                                @Model.Longitude
                            </div>

                        </div>

                    </div>


                    <hr />

                    <div class="mb-3">

                        <strong>📅 Submitted:</strong>

                        <div>
                            @Model.CreatedAt.ToString("dd-MM-yyyy hh:mm tt")
                        </div>

                    </div>


                    @if (Model.ResolvedAt != null)
                    {
                        <div class="mb-3">

                            <strong>✅ Resolved:</strong>

                            <div>
                                @Model.ResolvedAt.Value.ToString(
                                    "dd-MM-yyyy hh:mm tt")
                            </div>

                        </div>
                    }
                    <hr />

