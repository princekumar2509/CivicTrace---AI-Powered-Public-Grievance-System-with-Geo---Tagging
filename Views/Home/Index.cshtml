        <!-- BEFORE & AFTER RESOLUTION SLIDESHOW -->

        @{
    var slides = new List<dynamic>();

    if (ViewBag.BeforeAfterSlides is System.Collections.IEnumerable items)
    {
        foreach (var item in items)
        {
            slides.Add(item);
        }
    }
}

        <section class="before-after-section mb-5">

            <div class="overview-heading">
                <span class="before-after-kicker">
                    CIVICTRACE IMPACT
                </span>

                <h2>Before & After Resolution</h2>

                <p>
                    See the difference made when reported public issues
                    are successfully resolved.
                </p>
            </div>

            @if (slides.Count > 0)
            {
                <div class="before-after-shell">

                    <div id="beforeAfterCarousel"
                         class="carousel slide before-after-carousel"
                         data-bs-ride="carousel"
                         data-bs-interval="3000"
                         data-bs-pause="hover">

                        <div class="carousel-inner">

                            @for (int i = 0; i < slides.Count; i++)
                            {
                                var slide = slides[i];

                                <div class="carousel-item @(i == 0 ? "active" : "")">

                                    <div class="before-after-slide-card">

                                        <div class="row g-0">

                                            <!-- BEFORE IMAGE -->
                                            <div class="col-md-6">

                                                <div class="before-after-image">

                                                    <span class="before-after-tag before">
                                                        BEFORE
                                                    </span>

                                                    <img src="@slide.BeforeImagePath"
                                                         alt="Original complaint photograph"
                                                         loading="lazy" />

                                                </div>

                                            </div>

                                            <!-- AFTER IMAGE -->
                                            <div class="col-md-6">

                                                <div class="before-after-image">

                                                    <span class="before-after-tag after">
                                                        AFTER
                                                    </span>

                                                    <img src="@slide.AfterImagePath"
                                                         alt="Resolved complaint photograph"
                                                         loading="lazy" />

                                                </div>

                                            </div>

                                        </div>

                                        <div class="before-after-caption">

                                            <h5>@slide.Title</h5>

                                            <p>
                                                <span class="text-success fw-bold">
                                                    ✓ Successfully Resolved
                                                </span>
                                                &nbsp; | &nbsp;
                                                Complaint #@slide.ComplaintId
                                            </p>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                        <!-- PREVIOUS BUTTON -->
                        <button class="carousel-control-prev"
                                type="button"
                                data-bs-target="#beforeAfterCarousel"
                                data-bs-slide="prev"
                                aria-label="Previous slide">

                            <span class="carousel-control-prev-icon"></span>

                        </button>

                        <!-- NEXT BUTTON -->
                        <button class="carousel-control-next"
                                type="button"
                                data-bs-target="#beforeAfterCarousel"
                                data-bs-slide="next"
                                aria-label="Next slide">

                            <span class="carousel-control-next-icon"></span>

                        </button>

                        <!-- SLIDE INDICATORS -->
                        <div class="carousel-indicators">

                            @for (int i = 0; i < slides.Count; i++)
                            {
                                <button type="button"
                                        data-bs-target="#beforeAfterCarousel"
                                        data-bs-slide-to="@i"
                                        class="@(i == 0 ? "active" : "")"
                                        aria-label="Slide @(i + 1)">
                                </button>
                            }

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="before-after-shell text-center py-5">

                    <h5 class="fw-bold text-primary">
                        Community Improvements
                    </h5>

                    <p class="text-muted mb-0">
                        Before-and-after photographs of resolved
                        complaints will appear here.
                    </p>

                </div>
            }

        </section>

        <!-- Main features -->
