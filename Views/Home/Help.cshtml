
@{
    ViewData["Title"] = "Help & How It Works";
}

<style>
    /* CivicTrace Help page - dark premium theme */
    
.help-page {
    background: #071426 !important;
    color: #EAF6FF !important;
    padding-bottom: 45px;
    min-height: 100vh;

    /* Full browser width */
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    box-sizing: border-box;
    position: relative;
}


    .help-hero {
        background:
            radial-gradient(circle at 85% 15%, rgba(32, 215, 232, 0.13), transparent 34%),
            linear-gradient(145deg, #122D4D 0%, #0B1B30 100%) !important;
        color: #F5FBFF !important;
        padding: 54px 20px;
        text-align: center;
        border: 1px solid #244967;
        border-radius: 0 0 25px 25px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.20);
    }

    .help-hero h1 {
        color: #38DDF0 !important;
        font-size: clamp(2rem, 5vw, 2.8rem);
        font-weight: 850;
        margin-bottom: 12px;
    }

    .help-hero p {
        max-width: 760px;
        margin: auto;
        color: #CBD5E1 !important;
        line-height: 1.8;
    }

    .help-container {
        max-width: 1150px;
        margin: auto;
        padding: 38px 18px 0;
    }

    .help-card {
        height: 100%;
        padding: 24px;
        background: linear-gradient(145deg, #122A44, #0D1F34) !important;
        color: #EAF6FF !important;
        border: 1px solid #294967 !important;
        border-radius: 16px;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18);
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .help-card:hover {
        transform: translateY(-3px);
        border-color: #20BFD5 !important;
        box-shadow: 0 12px 28px rgba(0, 190, 220, 0.10);
    }

    .help-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        background: rgba(32, 215, 232, 0.12) !important;
        border: 1px solid rgba(32, 215, 232, 0.35);
        color: #38DDF0 !important;
        border-radius: 14px;
        font-size: 25px;
        margin-bottom: 16px;
    }

    .help-card h2 {
        font-size: 1.15rem;
        font-weight: 800;
        color: #F5FBFF !important;
        margin-bottom: 12px;
    }

    .help-card p,
    .help-card li {
        color: #C4D3E3 !important;
        line-height: 1.8;
    }

    .help-card ul {
        padding-left: 20px;
        margin-bottom: 0;
    }

    .help-heading {
        text-align: center;
        margin-bottom: 25px;
    }

    .help-heading h2 {
        color: #38DDF0 !important;
        font-weight: 850;
        margin-bottom: 8px;
    }

    .help-heading p {
        color: #AFC2D7 !important;
        line-height: 1.7;
    }

    .help-faq {
        padding: 20px 22px;
        border-bottom: 1px solid #29445F !important;
    }

    .help-faq:last-child {
        border-bottom: none !important;
    }

    .help-faq h3 {
        font-size: 1rem;
        color: #F5FBFF !important;
        font-weight: 800;
        margin-bottom: 9px;
    }

    .help-faq p {
        color: #C4D3E3 !important;
        line-height: 1.8;
        margin-bottom: 0;
    }

    .help-cta {
        position: relative;
        display: block;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        clear: both;
        background:
            radial-gradient(circle at 85% 10%, rgba(32, 215, 232, 0.12), transparent 35%),
            linear-gradient(145deg, #122A44, #0B1B30) !important;
        color: #F5FBFF !important;
        text-align: center;
        padding: 38px 22px;
        margin: 0 0 20px;
        border: 1px solid #294967 !important;
        border-radius: 18px;
        overflow-wrap: anywhere;
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.20);
    }

    .help-cta h2 {
        position: static;
        max-width: 100%;
        color: #FFFFFF !important;
        font-weight: 850;
        margin-bottom: 12px;
    }

    .help-cta p {
        position: static;
        max-width: 760px;
        margin: 0 auto 20px;
        color: #CBD5E1 !important;
        line-height: 1.8;
    }

    .help-btn {
        display: inline-block;
        padding: 12px 22px;
        margin: 5px;
        border-radius: 10px;
        font-weight: 800;
        text-decoration: none;
        background: linear-gradient(120deg, #36E7CA, #15B9DF) !important;
        color: #04213A !important;
        border: 1px solid #42E7DC !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .help-btn:hover {
        background: linear-gradient(120deg, #20DCC5, #0DAFD8) !important;
        color: #04213A !important;
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(32, 215, 232, 0.20);
    }

    @@media (max-width: 767.98px) {
        .help-hero {
            padding: 38px 16px;
            border-radius: 0 0 20px 20px;
        }

        .help-container {
            padding: 24px 13px 0;
        }

        .help-card {
            padding: 19px;
        }

        .help-cta {
            padding: 30px 17px;
        }
    }
</style>

<div class="help-page">

    <section class="help-hero">
        <div class="container">
            <div style="font-size: 2.7rem;" class="mb-2">💡</div>
            <h1>Help & How It Works</h1>
            <p>
                Learn how to register, report a public problem, provide
                location details, and follow the progress of your complaint.
            </p>
        </div>
    </section>

    <div class="help-container">

        <section class="mb-5">
            <div class="help-heading">
                <h2>Getting Started</h2>
                <p>Follow these steps to use the website.</p>
            </div>

            <div class="row g-4">

                <div class="col-md-6 col-lg-4">
                    <div class="help-card">
                        <div class="help-icon">👤</div>
                        <h2>1. Register or Login</h2>
                        <p class="mb-0">
                            Create an account using the registration page.
                            If you already have an account, log in to open
                            your Citizen Dashboard.
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="help-card">
                        <div class="help-icon">📝</div>
                        <h2>2. Submit a Complaint</h2>
                        <p class="mb-0">
                            Open Submit Complaint and enter a clear title
                            and description of the public problem you want
                            to report.
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="help-card">
                        <div class="help-icon">📍</div>
                        <h2>3. Add Location</h2>
                        <p class="mb-0">
                            Provide the available location details so the
                            issue can be identified more easily. Check that
                            the selected location is correct.
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="help-card">
                        <div class="help-icon">📷</div>
                        <h2>4. Upload Evidence</h2>
                        <p class="mb-0">
                            If available, upload a clear photograph that
                            shows the problem. Avoid including unnecessary
                            personal information in the image.
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="help-card">
                        <div class="help-icon">🔎</div>
                        <h2>5. Track Your Complaint</h2>
                        <p class="mb-0">
                            Use your dashboard or the complaint tracking
                            facility to check the current status and
                            available update history.
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="help-card">
                        <div class="help-icon">✅</div>
                        <h2>6. Check Resolution</h2>
                        <p class="mb-0">
                            Review the latest status to see whether the
                            complaint is submitted, in progress, or
                            marked as resolved.
                        </p>
                    </div>
                </div>

            </div>
        </section>

        <section class="mb-5">
            <div class="help-heading">
                <h2>Understanding Complaint Status</h2>
                <p>
                    Status labels help you understand the recorded progress
                    of a complaint.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="help-card">
                        <div class="help-icon">📤</div>
                        <h2>Submitted</h2>
                        <p class="mb-0">
                            The complaint has been submitted and recorded
                            in the system.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="help-card">
                        <div class="help-icon">⚙️</div>
                        <h2>In Progress</h2>
                        <p class="mb-0">
                            The complaint has been marked as being
                            processed by the responsible officials.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="help-card">
                        <div class="help-icon">✅</div>
                        <h2>Resolved</h2>
                        <p class="mb-0">
                            An authorized official has marked the complaint
                            as resolved in the system.
                        </p>
                    </div>
                </div>

            </div>
        </section>

        <section class="mb-5">
            <div class="help-heading">
                <h2>Frequently Asked Questions</h2>
                <p>Quick answers to common questions.</p>
            </div>

            <div class="help-card p-0">

                <div class="help-faq">
                    <h3>Can I track a complaint after submitting it?</h3>
                    <p>
                        Yes. Open your Citizen Dashboard or use the
                        available complaint tracking page to check
                        the complaint's status.
                    </p>
                </div>

                <div class="help-faq">
                    <h3>Why should I provide a location?</h3>
                    <p>
                        Location details help identify where the problem
                        occurred and can help officials understand
                        where attention is needed.
                    </p>
                </div>

                <div class="help-faq">
                    <h3>What if I do not have a photograph?</h3>
                    <p>
                        You can leave the photograph out if the form
                        permits it. Provide a clear description and
                        the available location information.
                    </p>
                </div>

                <div class="help-faq">
                    <h3>What does a possible duplicate warning mean?</h3>
                    <p>
                        It means the system has identified a complaint
                        that may be similar to an existing one. Review
                        the warning and follow the options shown on
                        the submission page.
                    </p>
                </div>

                <div class="help-faq">
                    <h3>Can I view another citizen's complaint details?</h3>
                    <p>
                        Citizen complaint pages are intended to restrict
                        access according to complaint ownership.
                        Authorized officials may have different access
                        based on their permissions.
                    </p>
                </div>

                <div class="help-faq">
                    <h3>What should I do if a page does not work?</h3>
                    <p>
                        Refresh the page and check your internet connection.
                        If the issue continues, contact the website
                        administrator with a description of the problem.
                    </p>
                </div>
                
<div class="help-faq">
    <h3>What happens after I submit a complaint?</h3>
    <p>
        After submission, the system stores your complaint and uses
        its classification logic to suggest a category, department,
        and priority. Authorized officials can then review and
        process the complaint.
    </p>
</div>

<div class="help-faq">
    <h3>How is my complaint category selected?</h3>
    <p>
        CivicTrace uses AI-assisted classification to analyze
        the complaint description and suggest a suitable category
        and department. The suggestions can be reviewed by officials.
    </p>
</div>

<div class="help-faq">
    <h3>Can I upload multiple photographs?</h3>
    <p>
        Yes, if multiple image uploads are enabled. The number
        of photographs and supported file formats depend on
        the system settings.
    </p>
</div>

<div class="help-faq">
    <h3>How is complaint priority determined?</h3>
    <p>
        The system can suggest a priority based on the complaint
        category and description. Authorized officials can review
        and update the priority when required.
    </p>
</div>

<div class="help-faq">
    <h3>What does complaint escalation mean?</h3>
    <p>
        Escalation is a process for bringing overdue complaints
        to the attention of responsible officials so that
        necessary action can be taken.
    </p>
</div>

<div class="help-faq">
    <h3>What is a resolution deadline?</h3>
    <p>
        A resolution deadline is the expected time for resolving
        a complaint. CivicTrace can configure different resolution
        targets for High, Medium, and Low priority complaints.
    </p>
</div>

<div class="help-faq">
    <h3>How will I know if my complaint is resolved?</h3>
    <p>
        You can visit your Citizen Dashboard or complaint tracking
        page to check the latest status and available complaint
        history.
    </p>
</div>

<div class="help-faq">
    <h3>Why was my complaint identified as a possible duplicate?</h3>
    <p>
        CivicTrace checks whether a newly submitted complaint
        appears similar to an existing complaint. You can review
        the warning and use the available submission options.
    </p>
</div>

<div class="help-faq">
    <h3>Is my personal information visible to other citizens?</h3>
    <p>
        Citizen-facing complaint pages are designed to restrict
        access according to complaint ownership. Citizens should
        only be able to access their own complaint details.
    </p>
</div>

<div class="help-faq">
    <h3>Can I reopen a resolved complaint?</h3>
    <p>
        Reopening depends on the system settings configured by
        the administrator. If this option is enabled, eligible
        resolved complaints can be reopened according to the
        configured rules.
    </p>
</div>


            </div>
        </section>

        <section class="help-cta">
            <h2>Ready to Report a Public Problem?</h2>
            <p>
                Log in to your account to submit a complaint and follow
                its progress through your dashboard.
            </p>


@if (User.Identity?.IsAuthenticated != true)
{
    <a asp-area="Identity"
asp-page="/Account/Login"
    class="help-btn">
        🔐 Login
    </a>

    <a asp-area="Identity"
    asp-page="/Account/Register"
    class="help-btn">
        📝 Register
    </a>
}

        </section>

    </div>
</div>
