@model PublicGrievanceSystem.Models.Complaint

@{
    ViewData["Title"] = "Complaint Details";

    var statusHistory =
        ViewBag.StatusHistory
        as List<PublicGrievanceSystem.Models.ComplaintStatusHistory>
        ?? new List<PublicGrievanceSystem.Models.ComplaintStatusHistory>();
                var evidenceImages = Model.Evidences?
        .Where(e => !string.IsNullOrWhiteSpace(e.ImagePath))
        .Select(e => e.ImagePath)
        .Distinct()
        .ToList()
        ?? new List<string>();

    // Keep older complaints compatible with the original ImagePath field.
    if (!string.IsNullOrWhiteSpace(Model.ImagePath) &&
        !evidenceImages.Contains(Model.ImagePath))
    {
        evidenceImages.Insert(0, Model.ImagePath);
    }

// Retrieve authority's resolution photographs.
var resolutionEvidenceImages =
    ViewBag.ResolutionEvidence
    as List<PublicGrievanceSystem.Models.ComplaintResolutionEvidence>
    ?? new List<PublicGrievanceSystem.Models.ComplaintResolutionEvidence>();
        var resolutionResponse =
    ViewBag.ResolutionResponse
    as PublicGrievanceSystem.Models.ComplaintResolutionResponse;

var isResolutionDisputed =
    resolutionResponse?.Decision == "NotResolved" &&
    resolutionResponse?.ReviewStatus == "Pending";
}

<div class="container py-4 complaint-details-page">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 complaint-details-header">

        <div>
            <h2 class="fw-bold mb-1">
                Complaint Details
            </h2>

            <p class="text-muted mb-0">
                Complaint #@Model.Id
            </p>
        </div>

        <div>
            <a asp-controller="Citizen"
               asp-action="Index"
               class="btn btn-outline-secondary me-2">
                ← My Complaints
            </a>

            <a asp-controller="Complaints"
               asp-action="Track"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                🔎 Track Complaint
            </a>
            
@if (Model.Status == "Resolved" && ViewBag.AllowCitizenReopen == true)
{
    <form asp-controller="Citizen"
          asp-action="Reopen"
          method="post"
          class="d-inline ms-2">

        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit"
                class="btn btn-outline-warning"
                onclick="return confirm('Are you sure you want to reopen this complaint?');">
            🔄 Reopen Complaint
        </button>

    </form>
}

        </div>

    </div>


    <!-- Main Complaint Information -->
    <div class="row g-4">

        <!-- Left Column -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        📋 Complaint Information
                    </h4>
                </div>

                <div class="card-body">

                    <div class="row mb-3">

                        <div class="col-md-6">
                            <strong>Complaint ID</strong>
                            <div class="mt-1">
                                #@Model.Id
                            </div>
                        </div>

                        <div class="col-md-6">
                            <strong>Submitted Date</strong>
                            <div class="mt-1">
                                @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>

                    </div>


                    <hr />


                    <div class="mb-3">

                        <strong>Title</strong>

                        <div class="mt-1 fs-5">
                            @Model.Title
                        </div>

                    </div>


                    <div class="mb-3">

                        <strong>Description</strong>

                        <div class="mt-2 p-3 bg-light rounded">
                            @Model.Description
                        </div>

                    </div>


                    <div class="row">

                        <div class="col-md-4 mb-3">

                            <strong>Category</strong>

                            <div class="mt-2">
                                <span class="badge bg-secondary fs-6">
                                    @Model.Category
                                </span>
                            </div>

                        </div>


                        <div class="col-md-4 mb-3">

                            <strong>Priority</strong>

                            <div class="mt-2">

                                @if (Model.Priority == "High")
                                {
                                    <span class="badge bg-danger fs-6">
                                        High
                                    </span>
                                }
                                else if (Model.Priority == "Medium")
                                {
                                    <span class="badge bg-warning text-dark fs-6">
                                        Medium
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success fs-6">
                                        Low
                                    </span>
                                }

                            </div>

                        </div>


                        <div class="col-md-4 mb-3">

                            <strong>Status</strong>

                            <div class="mt-2">

                                @if (Model.Status == "Resolved")
                                {
                                    <span class="badge bg-success fs-6">
                                        ✅ Resolved
                                    </span>
                                }
                                else if (Model.Status == "In Progress")
                                {
                                    <span class="badge bg-primary fs-6">
                                        ⚙️ In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6">
                                        📤 Submitted
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>
<!-- AI Severity Prediction -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-white">
        <h4 class="mb-0">
            🤖 AI Severity Assessment
        </h4>
    </div>

    <div class="card-body">

        <div class="row align-items-center">

            <div class="col-md-4">
                <strong>AI Predicted Severity</strong>
            </div>

            <div class="col-md-4">

                @if (Model.AISeverity == "Critical")
                {
                    <span class="badge bg-danger fs-5">
                        🚨 Critical
                    </span>
                }
                else if (Model.AISeverity == "High")
                {
                    <span class="badge bg-danger fs-5">
                        🔴 High
                    </span>
                }
                else if (Model.AISeverity == "Medium")
                {
                    <span class="badge bg-warning text-dark fs-5">
                        🟡 Medium
                    </span>
                }
                else
                {
                    <span class="badge bg-success fs-5">
                        🟢 Low
                    </span>
                }

            </div>

            <div class="col-md-4 text-md-end mt-3 mt-md-0">

                <small class="text-muted">
                    Automatically predicted by AI
                </small>

            </div>

        </div>

    </div>

</div>
<!-- BEFORE AND AFTER RESOLUTION COMPARISON -->

@if (resolutionEvidenceImages.Any())
{
    var latestResolutionEvidence = resolutionEvidenceImages.First();

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white">
            <h4 class="mb-1">
                📸 Before & After Resolution
            </h4>

            <small class="text-muted">
                Compare the original issue with the repair completed by the authority.
            </small>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- BEFORE IMAGE -->
                <div class="col-md-6">

                    <div class="border rounded p-3 h-100">

                        <h5 class="fw-bold text-danger mb-3">
                            🔴 BEFORE
                        </h5>

                        @if (evidenceImages.Any())
                        {
                            <img src="@evidenceImages.First()"
                                 alt="Original complaint photograph"
                                 class="img-fluid rounded border"
                                 style="width:100%; height:260px; object-fit:contain; background:#f8f9fa;" />
                        }
                        else
                        {
                            <div class="text-center text-muted py-5">
                                Original photograph not available.
                            </div>
                        }

                        <p class="text-muted small mt-3 mb-0">
                            Original photograph submitted with the complaint.
                        </p>

                    </div>

                </div>

                <!-- AFTER IMAGE -->
                <div class="col-md-6">

                    <div class="border rounded p-3 h-100">

                        <h5 class="fw-bold text-success mb-3">
                            🟢 AFTER
                        </h5>

                        <img src="@latestResolutionEvidence.ImagePath"
                             alt="After-resolution photograph"
                             class="img-fluid rounded border"
                             style="width:100%; height:260px; object-fit:contain; background:#f8f9fa;" />

                        <p class="text-muted small mt-3 mb-0">
                            Resolution photograph uploaded by the authority.
                        </p>

                        <small class="text-muted d-block mt-2">
                            Uploaded:
                            @latestResolutionEvidence.UploadedAt.ToString("dd MMM yyyy, hh:mm tt")
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>
}
<!-- CITIZEN RESOLUTION VERIFICATION -->

@if (Model.Status == "Resolved" && resolutionEvidenceImages.Any())
{
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white">
            <h4 class="mb-1">
                ✅ Verify Complaint Resolution
            </h4>

            <small class="text-muted">
                Please review the after-resolution photograph and share your feedback.
            </small>
        </div>

        <div class="card-body">

            @if (TempData["ResolutionResponseSuccess"] != null)
            {
                <div class="alert alert-success">
                    ✅ @TempData["ResolutionResponseSuccess"]
                </div>
            }

            @if (TempData["ResolutionResponseError"] != null)
            {
                <div class="alert alert-danger">
                    ⚠️ @TempData["ResolutionResponseError"]
                </div>
            }

            <!-- PREVIOUS RESPONSE -->
            @if (ViewBag.ResolutionResponse != null)
            {
                <div class="alert alert-info">

                    <strong>Your previous response:</strong>

                    @if ((string)ViewBag.ResolutionResponse.Decision == "Confirmed")
                    {
                        <span>✅ You confirmed that the issue was resolved.</span>
                    }
                    else
                    {
                        <span>⚠️ You reported that the issue was not resolved.</span>
                    }

                    <div class="small mt-2">
                        Response date:
                        @(((DateTime)ViewBag.ResolutionResponse.RespondedAt)
                            .ToString("dd MMM yyyy, hh:mm tt"))
                    </div>

                </div>
            }

            <form asp-controller="Citizen"
                  asp-action="SubmitResolutionResponse"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Your Remarks (Optional)
                    </label>

                    <textarea name="remarks"
          class="form-control"
          rows="3"
          maxlength="1000"
          disabled="@(resolutionResponse?.Decision == "Confirmed")"
          placeholder="Share your feedback about the completed work...">@(resolutionResponse?.Remarks ?? "")</textarea>

                </div>

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
        name="decision"
        value="Confirmed"
        class="btn btn-success"
        disabled="@(resolutionResponse?.Decision == "Confirmed")">

                        ✅ Confirm Resolution

                    </button>

                    <button type="submit"
        name="decision"
        value="NotResolved"
        class="btn btn-outline-danger"
        disabled="@(resolutionResponse?.Decision == "Confirmed")">

                        ⚠️ Report Not Resolved

                    </button>

                </div>

            </form>

            <p class="text-muted small mt-3 mb-0">
                You can update your response later if your assessment changes.
                Reporting an unresolved issue will notify the system through
                the recorded complaint history for authority review.
            </p>

        </div>

    </div>
}
else if (Model.Status == "Resolved" && !resolutionEvidenceImages.Any())
{
    <div class="alert alert-info mb-4">
        ℹ️ The complaint has been marked as resolved, but the authority
        has not uploaded resolution proof yet. You can verify it once
        the photograph becomes available.
    </div>
}
@if (ViewBag.ResolutionResponse is PublicGrievanceSystem.Models.ComplaintResolutionResponse response &&
    (response.ReviewStatus == "Reopened" ||
     response.ReviewStatus == "Rejected"))
{
    if (response.ReviewStatus == "Reopened")
    {
        <div class="alert alert-success shadow-sm mb-4">
            <h5 class="fw-bold">
                <i class="fas fa-check-circle me-2"></i>
                Admin Approved Your Reopening Request
            </h5>

            <p class="mb-2">
                The administrator has accepted your objection.
                Your complaint has been reopened for further action.
            </p>

            @if (!string.IsNullOrWhiteSpace(response.AdminRemarks))
            {
                <p class="mb-2">
                    <strong>Admin Remarks:</strong>
                    @response.AdminRemarks
                </p>
            }

            <small class="text-muted">
                Reviewed on:
                @response.ReviewedAt?.ToString("dd MMM yyyy, hh:mm tt")
            </small>
        </div>
    }
    else
    {
        <div class="alert alert-danger shadow-sm mb-4">
            <h5 class="fw-bold">
                <i class="fas fa-times-circle me-2"></i>
                Admin Rejected Your Reopening Request
            </h5>

            <p class="mb-2">
                The administrator has reviewed your objection and rejected it.
                Your complaint remains resolved.
            </p>

            @if (!string.IsNullOrWhiteSpace(response.AdminRemarks))
            {
                <p class="mb-2">
                    <strong>Admin Remarks:</strong>
                    @response.AdminRemarks
                </p>
            }

            <small class="text-muted">
                Reviewed on:
                @response.ReviewedAt?.ToString("dd MMM yyyy, hh:mm tt")
            </small>
        </div>
    }
}
            <!-- Location -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white">
                    <h4 class="mb-0">
                        📍 Location Information
                    </h4>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-8 mb-3">

                            <strong>Address</strong>

                            <div class="mt-1">
                                @(string.IsNullOrWhiteSpace(Model.Address)
                                    ? "Address not available"
                                    : Model.Address)
                            </div>

                        </div>

                        <div class="col-md-4 mb-3">

                            <strong>PIN Code</strong>

                            <div class="mt-1">
                                @(string.IsNullOrWhiteSpace(Model.PinCode)
                                    ? "Not available"
                                    : Model.PinCode)
                            </div>

                        </div>

                    </div>


                    <div class="row">

                        <div class="col-md-6">

                            <strong>Latitude</strong>

                            <div class="mt-1">
                                @Model.Latitude
                            </div>

                        </div>

                        <div class="col-md-6">

                            <strong>Longitude</strong>

                            <div class="mt-1">
                                @Model.Longitude
                            </div>

                        </div>

                    </div>

                </div>

                        </div>


            <!-- Complaint Location Map -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white">
                    <h4 class="mb-0">
                        🗺️ Complaint Location
                    </h4>
                </div>

                <div class="card-body p-0">

                    <div id="complaintMap"
                        style="height: 350px; width: 100%; border-radius: 0 0 8px 8px;">
                    </div>

                </div>

            </div>


            <!-- AI Analysis -->
            @if (!string.IsNullOrWhiteSpace(Model.AIImageCategory))
            {
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white">
                        <h4 class="mb-0">
                            🤖 AI Image Analysis
                        </h4>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            <div class="col-md-4 mb-3">

                                <strong>AI Category</strong>

                                <div class="mt-2">
                                    <span class="badge bg-info text-dark fs-6">
                                        @Model.AIImageCategory
                                    </span>
                                </div>

                            </div>


                            <div class="col-md-4 mb-3">

                                <strong>Confidence</strong>

                                <div class="mt-2">

                                    @if (Model.AIImageConfidence.HasValue)
                                    {
                                        <span class="fw-bold">
                                            @(Model.AIImageConfidence.Value * 100)
                                            %
                                        </span>
                                    }
                                    else
                                    {
                                        <span>Not available</span>
                                    }

                                </div>

                            </div>


                            <div class="col-md-12">

                                <strong>AI Observation</strong>

                                <div class="mt-2 p-3 bg-light rounded">
                                    @Model.AIImageDescription
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
            


            <!-- Status History Timeline -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-white">
        <h4 class="mb-0">
            🕒 Complaint Progress
        </h4>
    </div>

    <div class="card-body">

        @if (statusHistory.Any())
        {
            <div class="complaint-timeline">

                @foreach (var history in statusHistory)
                {
                    var isPendingResolutionReview =
    isResolutionDisputed &&
    history.Remarks ==
    "Citizen reported that the issue is not resolved and requested further action.";
                    var statusClass = isPendingResolutionReview
    ? "timeline-warning"
    : history.Status switch
    {
        "Resolved" => "timeline-success",
        "In Progress" => "timeline-primary",
        _ => "timeline-secondary"
    };

                    var statusIcon = isPendingResolutionReview
    ? "⚠️"
    : history.Status switch
    {
        "Resolved" => "✅",
        "In Progress" => "⚙️",
        _ => "📤"
    };

                    <div class="timeline-item @statusClass">

                        <div class="timeline-marker">
                            @statusIcon
                        </div>

                        <div class="timeline-content">

                            <div class="d-flex justify-content-between align-items-start flex-wrap">

                                <div>
                                    <h5 class="fw-bold mb-1">
    @if (isPendingResolutionReview)
    {
        <span>Resolution Disputed – Awaiting Admin Review</span>
    }
    else
    {
        @history.Status
    }
</h5>

                                    @if (!string.IsNullOrWhiteSpace(history.Department))
                                    {
                                        <div class="text-muted small mb-2">
                                            🏢 Department:
                                            <strong>
                                                @history.Department
                                            </strong>
                                        </div>
                                    }
                                </div>

                                <span class="text-muted small">
                                    @history.ChangedAt.ToString(
                                        "dd MMM yyyy, hh:mm tt")
                                </span>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(history.Remarks))
                            {
                                <div class="timeline-remarks">
                                    @history.Remarks
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(history.Priority))
                            {
                                <div class="mt-2">

                                    <span class="badge bg-light text-dark border">
                                        Priority: @history.Priority
                                    </span>

                                </div>
                            }

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="text-center py-4">

                <div class="fs-1 mb-2">
                    🕒
                </div>

                <p class="text-muted mb-0">
                    No status history available yet.
                </p>

            </div>
        }

    </div>

</div>

        </div>


        <!-- Right Column -->
        <div class="col-lg-4">

            <!-- Current Status -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Current Status
                    </h5>
                </div>

                <div class="card-body text-center">

                    <div class="display-5 mb-3">
                        @if (Model.Status == "Resolved")
                        {
                            <span>✅</span>
                        }
                        else if (Model.Status == "In Progress")
                        {
                            <span>⚙️</span>
                        }
                        else
                        {
                            <span>📤</span>
                        }
                    </div>

                    <h4>
                        @Model.Status
                    </h4>

                    @if (!string.IsNullOrWhiteSpace(Model.Department))
                    {
                        <p class="text-muted mb-0">
                            Assigned to:
                            <strong>@Model.Department</strong>
                        </p>
                    }

                </div>

            </div>


            <!-- Resolution -->
            @if (Model.ResolvedAt.HasValue)
            {
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            ✅ Resolution
                        </h5>
                    </div>

                    <div class="card-body">

                        <p class="mb-0">
                            Resolved on:
                            <strong>
                                @Model.ResolvedAt.Value.ToString(
                                    "dd MMM yyyy, hh:mm tt")
                            </strong>
                        </p>

                    </div>

                </div>
            }


            
            <!-- Evidence Gallery -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        📷 Complaint Evidence
                    </h5>
                </div>

                <div class="card-body">

                    @if (evidenceImages.Any())
                    {
                        <div class="row g-3">

                            @foreach (var imagePath in evidenceImages)
                            {
                                <div class="col-12 col-md-6">
                                    <div class="evidence-preview h-100">

                                        <a href="@imagePath"
                                           target="_blank"
                                           rel="noopener noreferrer">

                                            <img src="@imagePath"
                                                 class="img-fluid rounded border"
                                                 alt="Complaint evidence"
                                                 style="width:100%; height:220px; object-fit:contain; background:#f8f9fa; padding:8px;" />
                                        </a>

                                        <div class="text-center mt-2">
                                            <a href="@imagePath"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-primary">
                                                🔍 View Full Image
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <div style="font-size:60px;">
                                📷
                            </div>

                            <h5 class="mt-3 text-muted">
                                No Evidence Images
                            </h5>

                            <p class="text-muted mb-0">
                                No images were uploaded with this complaint.
                            </p>

                        </div>
                    }

                </div>

            </div>


        </div>

    </div>

</div>
@section Scripts {

    <style>

        .complaint-timeline {
            position: relative;
            padding-left: 20px;
        }

        .complaint-timeline::before {
            content: "";
            position: absolute;
            left: 25px;
            top: 20px;
            bottom: 20px;
            width: 3px;
            background: #dee2e6;
        }

        .timeline-item {
            position: relative;
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
        }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

        .timeline-marker {
            position: relative;
            z-index: 2;
            width: 42px;
            min-width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
            border: 3px solid #6c757d;
            font-size: 18px;
        }

        .timeline-content {
            flex: 1;
            background: #f8f9fa;
            border-radius: 10px;
            padding: 16px 18px;
            border-left: 4px solid #6c757d;
        }

        .timeline-primary .timeline-marker {
            border-color: #0d6efd;
        }

        .timeline-primary .timeline-content {
            border-left-color: #0d6efd;
        }

        .timeline-success .timeline-marker {
            border-color: #198754;
        }

        .timeline-success .timeline-content {
            border-left-color: #198754;
        }

        .timeline-secondary .timeline-marker {
            border-color: #6c757d;
        }

        .timeline-secondary .timeline-content {
            border-left-color: #6c757d;
        }

        .timeline-content h5 {
            margin: 0;
        }

        .timeline-remarks {
            margin-top: 8px;
            padding: 10px 12px;
            background: white;
            border-radius: 6px;
            color: #495057;
        }

/* ==========================================
   CIVICTRACE COMPLAINT DETAILS PAGE
========================================== */

.complaint-details-page {
    max-width: 1440px;
    color: #23364d;
    padding-top: 32px !important;
    padding-bottom: 40px !important;
}

/* Main page heading */
.complaint-details-header {
    gap: 18px;
    flex-wrap: wrap;
}

.complaint-details-header h2 {
    color: #153b6d;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.5px;
}

.complaint-details-header p {
    color: #64748b !important;
    font-size: 1rem;
}

/* Back and tracking buttons */
.complaint-details-page .btn {
    border-radius: 9px;
    padding: 9px 16px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.complaint-details-page .btn-primary {
    background: linear-gradient(120deg, #142d4e, #245ca8);
    border-color: #245ca8;
    color: #fff;
}

.complaint-details-page .btn-primary:hover {
    background: linear-gradient(120deg, #0e213a, #1b4b8c);
    border-color: #1b4b8c;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(20, 45, 78, 0.2);
}

.complaint-details-page .btn-outline-secondary {
    color: #245ca8;
    border-color: #cbd8e8;
    background: #fff;
}

.complaint-details-page .btn-outline-secondary:hover {
    background: #eaf2ff;
    color: #153b6d;
    border-color: #245ca8;
}

/* Cards */
.complaint-details-page .card {
    border: 1px solid #e3ebf5 !important;
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 5px 18px rgba(25, 55, 95, 0.07) !important;
    transition: box-shadow 0.2s ease;
}

.complaint-details-page .card:hover {
    box-shadow: 0 8px 24px rgba(25, 55, 95, 0.11) !important;
}

/* Card headings */
.complaint-details-page .card-header {
    padding: 17px 20px;
    border-bottom: 1px solid #e2eaf5;
}

.complaint-details-page .card-header.bg-primary {
    background: linear-gradient(120deg, #142d4e, #245ca8) !important;
    color: #fff;
}

.complaint-details-page .card-header.bg-white {
    background: #f8fbff !important;
}

.complaint-details-page .card-header h4,
.complaint-details-page .card-header h5 {
    color: #153b6d;
    font-weight: 750;
    font-size: 1.25rem;
}

.complaint-details-page .card-header.bg-primary h4 {
    color: #fff;
    font-size: 1.4rem;
}

/* Card content and labels */
.complaint-details-page .card-body {
    padding: 22px;
}

.complaint-details-page .card-body strong {
    color: #243b57;
}

.complaint-details-page .card-body hr {
    border-color: #dce6f2;
    opacity: 1;
    margin: 20px 0;
}

.complaint-details-page .card-body .bg-light {
    background: #f4f7fb !important;
    border: 1px solid #edf1f7;
    border-radius: 9px !important;
    line-height: 1.75;
    overflow-wrap: anywhere;
}

.complaint-details-page .badge {
    border-radius: 7px;
    padding: 7px 11px;
    font-weight: 650;
    letter-spacing: 0.1px;
}

/* Current status panel */
.complaint-details-page .card-body.text-center .display-5 {
    font-size: 3.2rem;
    line-height: 1.2;
}

.complaint-details-page .card-body.text-center h4 {
    color: #153b6d;
    font-weight: 750;
    margin-bottom: 12px;
}

/* Resolution panel */
.complaint-details-page .card-header.bg-success {
    background: linear-gradient(120deg, #147d55, #22996b) !important;
}

.complaint-details-page .card-header.bg-success h5 {
    color: #fff;
}

/* Evidence image */
.complaint-details-page .evidence-preview {
    padding: 8px;
    border: 1px solid #dce6f2;
    border-radius: 11px;
    background: #f7faff;
}

.complaint-details-page .evidence-preview img {
    border-radius: 7px !important;
    border-color: #dce6f2 !important;
}

.complaint-details-page .btn-outline-primary {
    color: #245ca8;
    border-color: #245ca8;
    background: #fff;
}

.complaint-details-page .btn-outline-primary:hover {
    color: #fff;
    border-color: #245ca8;
    background: linear-gradient(120deg, #142d4e, #245ca8);
}

/* Map */
.complaint-details-page #complaintMap {
    overflow: hidden;
    background: #f1f5f9;
    border-radius: 0 0 12px 12px;
}

/* AI severity and image analysis */
.complaint-details-page .card-body .text-md-end small {
    color: #64748b !important;
}

.complaint-details-page .card-body .badge.bg-info {
    background: #d9f4fb !important;
    color: #075985 !important;
    border: 1px solid #a5e5f5;
}

/* Complaint progress timeline */
.complaint-details-page .complaint-timeline {
    padding-left: 10px;
}

.complaint-details-page .complaint-timeline::before {
    background: #d8e4f2;
    width: 3px;
}

.complaint-details-page .timeline-item {
    gap: 12px;
    margin-bottom: 18px;
}

.complaint-details-page .timeline-marker {
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(20, 45, 78, 0.08);
}

.complaint-details-page .timeline-content {
    min-width: 0;
    border: 1px solid #e4ebf4;
    border-left: 4px solid #6c757d;
    border-radius: 10px;
    background: #f7f9fc;
    padding: 9px 12px;
    font-size: 0.92rem;
    line-height: 1.4;
}

.complaint-details-page .timeline-primary .timeline-content {
    border-left-color: #245ca8;
    background: #f2f7ff;
}

.complaint-details-page .timeline-success .timeline-content {
    border-left-color: #198754;
    background: #f0faf5;
}

.complaint-details-page .timeline-secondary .timeline-content {
    border-left-color: #6c757d;
}

.complaint-details-page .timeline-content h5 {
    color: #153b6d;
    font-size: 1rem;
    font-weight: 700;
}

.complaint-details-page .timeline-remarks {
    margin-top: 7px;
    padding: 8px 11px;
    background: #ffffff;
    border: 1px solid #e7edf5;
    border-radius: 7px;
    color: #495057;
    font-size: 0.9rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

/* Mobile responsiveness */
@@media (max-width: 767.98px) {
    .complaint-details-page {
        padding-top: 20px !important;
    }

    .complaint-details-header {
        align-items: flex-start !important;
    }

    .complaint-details-header > div:last-child {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .complaint-details-header .btn {
        margin-right: 0 !important;
        font-size: 0.9rem;
    }

    .complaint-details-page .card-header {
        padding: 14px 16px;
    }

    .complaint-details-page .card-body {
        padding: 17px;
    }

    .complaint-details-page .timeline-content {
        padding: 13px;
    }

    .complaint-details-page .timeline-item {
        gap: 10px;
    }
}

    </style>


    <link rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            var latitude = @Model.Latitude;
            var longitude = @Model.Longitude;

            var map = L.map('complaintMap').setView(
                [latitude, longitude],
                16
            );

            L.tileLayer(
                'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
                {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }
            ).addTo(map);

            L.marker([latitude, longitude])
                .addTo(map)
                .bindPopup(
                    "<strong>Complaint #@Model.Id</strong><br>" +
                    "Complaint Location"
                )
                .openPopup();

        });


    </script>
}