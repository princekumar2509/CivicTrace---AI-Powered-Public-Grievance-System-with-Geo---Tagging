
@{
    ViewData["Title"] = "Complaint Submission Unavailable";
}

<style>
    .submission-unavailable {
        max-width: 760px;
        margin: 65px auto;
        padding: 20px;
    }

    .maintenance-card {
        padding: 42px 30px;
        text-align: center;
        background: #fff;
        border: 1px solid #e1eaf5;
        border-radius: 20px;
        box-shadow: 0 10px 32px rgba(20, 45, 78, .08);
    }

    .maintenance-icon {
        width: 86px;
        height: 86px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        border-radius: 24px;
        background: #edf4ff;
        font-size: 42px;
    }

    .maintenance-card h1 {
        color: #153b6d;
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 800;
        margin-bottom: 14px;
    }

    .maintenance-card p {
        color: #64748b;
        line-height: 1.8;
    }

    .maintenance-link {
        display: inline-block;
        margin-top: 12px;
        padding: 11px 19px;
        color: white;
        background: #245ca8;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
    }

    .maintenance-link:hover {
        background: #174a91;
        color: white;
    }
</style>

<div class="container submission-unavailable">
    <div class="maintenance-card">

        <div class="maintenance-icon">🛠️</div>

        <h1>Complaint Submission Temporarily Unavailable</h1>

        <p>
            Complaint submission is temporarily unavailable.
            Please try again later.
        </p>

        <p class="mb-0">
            You can still access your existing complaints and check their status.
        </p>

        <a asp-controller="Citizen"
           asp-action="Index"
           class="maintenance-link">
            View My Complaints
        </a>

    </div>
</div>
